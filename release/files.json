{
  "format": "orchpact-public-source-v1",
  "candidate": "0.1.0",
  "directories": [
    "src",
    "tests",
    "examples",
    "contracts",
    "evals",
    "docker",
    "scripts",
    "release",
    ".github",
    ".githooks",
    "design/identity",
    "frontend/src",
    "frontend/licenses"
  ],
  "files": [
    ".dockerignore",
    ".env.example",
    ".gitattributes",
    ".gitignore",
    "Dockerfile",
    "compose.yaml",
    "pyproject.toml",
    "uv.lock",
    "LICENSE",
    "README.md",
    "README.en.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "config/models.toml",
    "config/execution.toml",
    "config/credits.toml",
    "config/security.toml",
    "config/search.toml",
    "THIRD_PARTY.md",
    "AGENTS.md",
    "frontend/build.mjs",
    "frontend/package.json",
    "frontend/package-lock.json",
    "frontend/LICENSE-shadcn.txt",
    "frontend/components.json",
    "frontend/tsconfig.json"
  ],
  "exclude_parts": [
    "__pycache__",
    ".venv",
    ".git",
    "var",
    "backups",
    "results",
    ".pytest_cache",
    ".DS_Store"
  ],
  "exclude_suffixes": [
    ".pyc",
    ".pyo",
    ".dump",
    ".db",
    ".db-wal",
    ".db-shm",
    ".pem"
  ],
  "note": "Public source allowlist. Runtime data, credentials and private validation evidence are excluded; review each addition.",
  "project": "orchpact"
}

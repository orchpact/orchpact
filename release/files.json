{
  "format": "orchpact-public-source-v1",
  "candidate": "0.1.0",
  "directories": [
    "src",
    "tests",
    "examples",
    "contracts",
    "evals",
    "docker",
    "scripts",
    "release",
    ".github",
    ".githooks"
  ],
  "files": [
    ".dockerignore",
    ".env.example",
    ".gitignore",
    "Dockerfile",
    "compose.yaml",
    "pyproject.toml",
    "uv.lock",
    "LICENSE",
    "README.md",
    "README.en.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "config/models.toml",
    "config/execution.toml",
    "config/credits.toml",
    "config/security.toml",
    "config/search.toml",
    "docs/ARCHITECTURE.md",
    "docs/APPLICATIONS.md",
    "docs/WORKSPACES.md",
    "docs/PROVIDERS.md",
    "docs/POSTGRESQL.md",
    "docs/CONSOLE.md",
    "docs/SHOWCASE.md",
    "docs/WORKFLOWS.md",
    "docs/COMPATIBILITY.md",
    "docs/RELEASE_VALIDATION.md",
    "THIRD_PARTY.md",
    "docs/NAMING.md",
    "AGENTS.md",
    "docs/GETTING_STARTED.md",
    "docs/REPOSITORIES.md",
    "docs/EXECUTION_BOUNDARY.md",
    "docs/TEAM_EXECUTION.md"
  ],
  "exclude_parts": [
    "__pycache__",
    ".venv",
    ".git",
    "var",
    "backups",
    "results",
    ".pytest_cache",
    ".DS_Store"
  ],
  "exclude_suffixes": [
    ".pyc",
    ".pyo",
    ".dump",
    ".db",
    ".db-wal",
    ".db-shm",
    ".pem"
  ],
  "note": "Public source allowlist. Runtime data, credentials and private validation evidence are excluded; review each addition.",
  "project": "orchpact"
}

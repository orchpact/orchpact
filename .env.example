# Use a dedicated PostgreSQL database and a matching instance file directory.
ORCHPACT_DATABASE_URL=postgresql://orchpact:replace-with-a-db-password@127.0.0.1:5432/orchpact
ORCHPACT_API_TOKEN=replace-with-a-random-secret-at-least-32-characters
DEEPSEEK_API_KEY=
# Optional search sources; DeepSeek search reuses DEEPSEEK_API_KEY.
YDC_API_KEY=
TAVILY_API_KEY=
# Optional; only needed for an enabled image profile.
IMAGE_API_KEY=

# Optional image providers. enabled="auto" activates only with its own key.
ARK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

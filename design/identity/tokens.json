{
  "version": "1.0.0",
  "brand": {
    "indigo": "#262896",
    "lime": "#EAFF58",
    "paper": "#F7F4EB",
    "ink": "#181922"
  },
  "roles": {
    "page": {
      "light": "#F7F7FA",
      "dark": "#141520",
      "use": "页面底色"
    },
    "surface": {
      "light": "#FFFFFF",
      "dark": "#1D1E2D",
      "use": "卡片、表格、弹窗、文档文章"
    },
    "subtle": {
      "light": "#EEEFF6",
      "dark": "#282A3D",
      "use": "侧栏、悬停行、次级面板"
    },
    "text": {
      "light": "@brand.ink",
      "dark": "#F6F5FA",
      "use": "正文、标题与输入值"
    },
    "muted": {
      "light": "#505569",
      "dark": "#B5B7CA",
      "use": "图注、占位符、次级文字"
    },
    "line": {
      "light": "#D4D7E1",
      "dark": "#37394D",
      "use": "装饰性分隔线"
    },
    "control": {
      "light": "#71768A",
      "dark": "#878BA3",
      "use": "输入框边界、勾选框轮廓"
    },
    "action": {
      "light": "@brand.indigo",
      "dark": "#BCBDFF",
      "use": "常规主操作"
    },
    "action-hover": {
      "light": "#202178",
      "dark": "#CFD0FF",
      "use": "主操作悬停"
    },
    "action-active": {
      "light": "#171957",
      "dark": "#A9AAF2",
      "use": "主操作按下"
    },
    "on-action": {
      "light": "@brand.paper",
      "dark": "#17182B",
      "use": "主操作文字与图标"
    },
    "link": {
      "light": "#3033A3",
      "dark": "#BDBEFF",
      "use": "正文链接、当前导航文字"
    },
    "link-hover": {
      "light": "#20216F",
      "dark": "#DFDFFF",
      "use": "链接悬停"
    },
    "link-visited": {
      "light": "#684286",
      "dark": "#D8B8ED",
      "use": "已访问正文链接"
    },
    "selected-bg": {
      "light": "#E8E9FF",
      "dark": "#30315A",
      "use": "当前导航和选中项背景"
    },
    "focus": {
      "light": "#4744B8",
      "dark": "#C7C5FF",
      "use": "键盘焦点环"
    },
    "disabled-bg": {
      "light": "#EAEBF0",
      "dark": "#272835",
      "use": "禁用背景"
    },
    "disabled-fg": {
      "light": "#54586A",
      "dark": "#AFB1C3",
      "use": "禁用文字"
    },
    "hero-bg": {
      "light": "@brand.indigo",
      "dark": "@brand.indigo",
      "use": "官网品牌展台与品牌色带"
    },
    "on-hero": {
      "light": "@brand.paper",
      "dark": "@brand.paper",
      "use": "品牌展台正文与线条"
    },
    "delivery-bg": {
      "light": "@brand.lime",
      "dark": "@brand.lime",
      "use": "最终验收交付的局部标记底色"
    },
    "on-delivery": {
      "light": "@brand.ink",
      "dark": "@brand.ink",
      "use": "验收标记上的字与勾"
    },
    "edge": {
      "light": "#60677F",
      "dark": "#A3A8C0",
      "use": "画布依赖线和箭头"
    },
    "edge-selected": {
      "light": "@brand.indigo",
      "dark": "#CDCCFF",
      "use": "当前选中依赖线"
    },
    "code-bg": {
      "light": "#1A1B2B",
      "dark": "#10111B",
      "use": "终端和多行代码"
    },
    "code-text": {
      "light": "#F4F3FA",
      "dark": "#F4F3FA",
      "use": "代码块正文"
    },
    "code-comment": {
      "light": "#ABB0C8",
      "dark": "#ABB0C8",
      "use": "代码注释和行号"
    },
    "code-keyword": {
      "light": "#C9C1FF",
      "dark": "#C9C1FF",
      "use": "代码关键字"
    },
    "code-string": {
      "light": "#A3E6CC",
      "dark": "#A3E6CC",
      "use": "代码字符串"
    },
    "neutral-fg": {
      "light": "#4B5063",
      "dark": "#D5D7E5",
      "use": "中性状态文字与图标"
    },
    "neutral-bg": {
      "light": "#ECEEF4",
      "dark": "#303242",
      "use": "中性状态底色"
    },
    "info-fg": {
      "light": "#214B90",
      "dark": "#BCD6FF",
      "use": "信息状态文字与图标"
    },
    "info-bg": {
      "light": "#E7EFFF",
      "dark": "#202F4B",
      "use": "信息状态底色"
    },
    "success-fg": {
      "light": "#155B48",
      "dark": "#A0E6C8",
      "use": "局部检查通过文字与图标"
    },
    "success-bg": {
      "light": "#E2F4EB",
      "dark": "#18382E",
      "use": "局部检查通过底色"
    },
    "warning-fg": {
      "light": "#744600",
      "dark": "#FFDC9E",
      "use": "待处理或证据不足文字与图标"
    },
    "warning-bg": {
      "light": "#FFF0D0",
      "dark": "#412F18",
      "use": "待处理或证据不足底色"
    },
    "danger-fg": {
      "light": "#973037",
      "dark": "#FFB8BA",
      "use": "失败、拒绝、破坏性操作文字与图标"
    },
    "danger-bg": {
      "light": "#FCE8EA",
      "dark": "#47272E",
      "use": "失败或拒绝提示底色"
    }
  }
}

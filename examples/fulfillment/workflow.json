                "id",
                "daily_capacity",
                "stock"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "daily_capacity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "stock": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "A",
                    "B",
                    "C"
                  ],
                  "properties": {
                    "A": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100000
                    },
                    "B": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100000
                    },
                    "C": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100000

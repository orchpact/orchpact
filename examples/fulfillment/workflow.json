{
  "format": "orchpact-workflow",
  "id": "multi-warehouse-fulfillment",
  "name": "Multi-warehouse verified fulfillment",
  "version": "1.0.0",
  "description": "Fictional feasibility exercise: time-dependent inventory, transport capacities, deadlines, budget, independent review and root verification. No optimality or real-world logistics guarantee.",
  "resources": {
    "models": {
      "reasoning": {
        "capabilities": [
          "text",
          "json"
        ]
      }
    },
    "tools": {
      "verifier": {
        "interface": "example.fulfillment.verify",
        "version": "1",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact",
            "contract_digest",
            "parameters"
          ],
          "properties": {
            "artifact": {
              "type": "object"
            },
            "contract_digest": {
              "type": "string"
            },
            "parameters": {
              "type": "object"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "status",
            "checks"
          ],
          "properties": {
            "status": {
              "type": "string"
            },
            "checks": {
              "type": "array"
            },
            "evidence": {
              "type": "object"
            }
          }
        },
        "effect": "read"
      }
    }
  },
  "units": [
    {
      "key": "planning",
      "name": "Planning",
      "purpose": "Deliver a feasible fulfillment plan",
      "model": "reasoning"
    },
    {
      "key": "review",
      "name": "Independent review",
      "purpose": "Review current immutable planning artifacts",
      "model": "reasoning"
    }
  ],
  "operations": {
    "fulfill": {
      "unit": "planning",
